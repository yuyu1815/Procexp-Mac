    "sample failed for %@ (PID %d) with exit status %d. The process may have exited, or macOS may not allow this process to be sampled." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ (PID %2$d) の sample が終了ステータス %3$d で失敗しました。プロセスが終了したか、macOS がこのプロセスのサンプリングを許可していない可能性があります。"
          }
        }
      }
    },
    "sample reported success, but no output file was written at:\n\n%@" : {
